# ── Data (required) ──────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_KEY=

# ── LOFI AI agent (scout/chat + validation) ──────────────────────────────────
# LLM layer. Only enable once Lofi's permission + retention are settled.
ANTHROPIC_API_KEY=sk-ant-...
LOFI_LLM_ENABLED=          # 1 to turn Claude on (default off = preview mode)
LOFI_LLM_LANG=en           # en | nl  (the validation panel is always English)
# LOFI_LLM_MODEL=claude-opus-4-8
# LOFI_LLM_INFERENCE_GEO=us
# The validation panel uses Claude's managed web search (web_search_20260209).
# Enable web search ONCE in the Anthropic Console (org settings) or the call
# errors. Billing ~$10/1,000 searches; each validation uses <=4.

# Airtable (read-only) — booking history + per-artist economics for the AI.
# Defaults match LOFI's base: "Bookings / Line-up" + "Artists".
AIRTABLE_TOKEN=            # Airtable personal access token (data.records:read)
AIRTABLE_BASE_ID=          # app... (run: python -m scout.airtable  to discover)
# AIRTABLE_BOOKINGS_TABLE=Bookings / Line-up
# AIRTABLE_ARTISTS_TABLE=Artists
# Field-name overrides only if the schema changes — see scout/airtable.py (_BK/_AR).
# Verify the two-table join with: python -m scout.airtable verify

# ── Prediction layer (predict/) — venue economics + alerting ─────────────────
# LOFI_CAPACITY=500            # room capacity, drives slot fit + outgrow risk
# LOFI_TICKET_PRICE=15         # avg ticket €, drives the margin model
# LOFI_VARIABLE_COST_PCT=0.35  # per-head variable costs as share of ticket
# LOFI_FEE_ELASTICITY=0.7      # fee vs draw elasticity (sub-linear)
# LOFI_ALERT_WEBHOOK=          # Slack-compatible webhook for watchlist pushes
# BANDSINTOWN_APP_ID=          # enables the EU tour-routing signal

# ── Agentic OS (osk/) — the scheduled-agent kernel (docs/agentic_os.md) ──────
# Runs the four maintenance agents on a schedule: python -m osk loop
# (deploy/README.md has the full VPS story: docker compose or systemd.)
# LOFI_OS_BACKEND=sqlite       # sqlite (default) | supabase (needs migration)
# LOFI_OS_DB=osk/data/os.db    # blackboard path for the sqlite backend
# LOFI_OS_TICK_SECONDS=60      # scheduler resolution
# LOFI_OS_PAUSED=              # 1 = kill switch: loop keeps ticking, runs nothing
# LOFI_OS_WATCH_ALL=           # 1 = sentinel sweeps the whole unbooked pool
